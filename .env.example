# ============================================================
#  ENVIRONMENT VARIABLES  —  .env.example
# ============================================================
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your values below
#  3. NEVER commit .env to git  (it's already in .gitignore)
# ============================================================

# Supabase — found in: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Wonderful.org — JIC's secure donation page URL.
# Example format: https://wonderful.org/charities/your-charity-or-donation-page
# The website Donate buttons open this inside the JIC donation modal and also provide a secure fallback link.
VITE_WONDERFUL_DONATE_URL=

# Website forms use the submit-form Edge Function and private Forms inbox.
# Staff invitations and role changes are in Admin → Users & roles.
