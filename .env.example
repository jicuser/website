# ============================================================
#  ENVIRONMENT VARIABLES  —  .env.example
# ============================================================
#  1. Copy this file:  cp .env.example .env
#  2. Fill in your values below
#  3. NEVER commit .env to git  (it's already in .gitignore)
# ============================================================

# Supabase — found in: supabase.com → your project → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use a public anon JWT or publishable key from this project.
# Publishable keys require the matching supabase/config.toml and functions deployment.
# A service-role/secret key must never appear in any VITE_ variable.
VITE_SUPABASE_ANON_KEY=your-public-anon-jwt-here

# Keep false until the shared forms/learning/tasks migrations and functions are active.
# This is a build-time switch: changing it requires a new website build.
VITE_ENABLE_WORKSPACE=false

# Wonderful.org — JIC's secure donation page URL.
# Example format: https://wonderful.org/charities/your-charity-or-donation-page
# The website Donate buttons open this inside the JIC donation modal and also provide a secure fallback link.
VITE_WONDERFUL_DONATE_URL=

# Website forms use the submit-form Edge Function and private Forms inbox.
# Staff invitations and role changes are in Admin → Users & roles.

# Optional, public HTTPS origin of the separately deployed broadcast relay. No keys here.
VITE_MEDIA_RELAY_URL=
